{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/seguidores",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/demograficos",
      "schedule": "15 10 * * *"
    },
    {
      "path": "/api/seguidores?run=noche",
      "schedule": "40 2 * * *"
    },
    {
      "path": "/api/demograficos?run=noche",
      "schedule": "50 2 * * *"
    },
    {
      "path": "/api/publicaciones",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/anuncios",
      "schedule": "45 10 * * *"
    },
    {
      "path": "/api/mensajes",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/referentes",
      "schedule": "30 11 * * *"
    }
  ]
}
